# Walkthrough request form → email, via Resend.
# Copy to .env.local and fill in. .env* is gitignored; never commit real values.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where walkthrough requests land. Defaults to hello@parteli.com.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
# Defaults to "Parteli <onboarding@resend.dev>", which can ONLY deliver to the
# address that owns the Resend account — fine for testing, not for production.
CONTACT_FROM_EMAIL=

# Absolute base for the Open Graph image and canonical URL.
# Defaults to https://www.parteli.ca in code, so this is only needed to override —
# e.g. pointing a preview deploy's share card at itself. Not a secret.
NEXT_PUBLIC_SITE_URL=
