# Required.
RESEND_API_KEY=

# Where walkthrough requests land.
# Defaults to ryder@parteli.ca.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
# Defaults to "Parteli <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=

# Absolute base for the Open Graph image and canonical URL.
# Defaults to "https://www.parteli.ca"
NEXT_PUBLIC_SITE_URL=
